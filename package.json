{
  "name": "@johnmorrisdotca/tane",
  "version": "1.2.2",
  "description": "Tane \u7a2e \u2014 Seeded random numbers for JavaScript: reproducible streams, shuffle, pick, sample, weighted choice, daily seeds and saved positions. Zero dependencies.",
  "keywords": [
    "angular",
    "cards",
    "cli",
    "command-line",
    "csv",
    "daily",
    "daily-challenge",
    "daily-puzzle",
    "daily-seed",
    "deck",
    "deterministic",
    "dice",
    "esm",
    "fisher-yates",
    "fnv-1a",
    "fork",
    "fuzz",
    "game",
    "gamedev",
    "games",
    "gaussian",
    "generator",
    "hash",
    "hooks",
    "i18n",
    "itsutsu",
    "japanese",
    "javascript",
    "json",
    "knuth-shuffle",
    "math-random",
    "mulberry32",
    "normal",
    "pick",
    "prng",
    "procedural",
    "procedural-generation",
    "procgen",
    "pseudorandom",
    "puzzle",
    "random",
    "random-number-generator",
    "react",
    "replay",
    "reproducible",
    "rng",
    "sample",
    "sampling",
    "seed",
    "seedable",
    "seeded",
    "seeded-random",
    "seeded-shuffle",
    "seedrandom",
    "shuffle",
    "simulation",
    "string-hash",
    "sub-streams",
    "svelte",
    "testing",
    "time-zone",
    "typescript",
    "vue",
    "weighted",
    "weighted-random",
    "wordle",
    "zero-dependencies"
  ],
  "homepage": "https://johnmorrisdotca.github.io/tane/",
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/tane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/tane.git"
  },
  "license": "MIT",
  "author": "John Morris",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "import": "./dist/element-define.js",
      "default": "./dist/element-define.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:demo": "pnpm site && node scripts/docs-site.mjs build && playwright test",
    "test:cli": "pnpm build && node scripts/check-cli.mjs",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "test:frameworks": "pnpm build && node scripts/check-frameworks.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "site": "pnpm build && node scripts/site.mjs",
    "docs:make": "node scripts/docs.mjs",
    "prepublishOnly": "pnpm check && pnpm build",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "docs:site": "pnpm build && node scripts/docs-site.mjs build",
    "docs:check": "pnpm build && node scripts/docs-site.mjs check",
    "size": "node scripts/docs-site.mjs size"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.0.0",
    "react": "^19.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0",
    "pagefind": "^1.5.2",
    "marked": "^18.0.0",
    "esbuild": "^0.28.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "bin": {
    "tane": "bin/tane.mjs"
  }
}
